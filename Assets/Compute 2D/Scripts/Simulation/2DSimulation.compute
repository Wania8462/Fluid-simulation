#include "C:\Users\Ivan\Documents\GitHub\Fluid-simulation\Assets\Compute 2D\Scripts\Simulation\FluidMath.hlsl"

static const float2 ZeroImpulse = float2(0, 0);
// Forces are stored as fixed-point ints so threads can sum them with InterlockedAdd
static const int FloatScale = 1000000;


RWStructuredBuffer<float2> Positions;
RWStructuredBuffer<float2> PrevPositions;
RWBuffer<int> ForceBuffersX;
RWBuffer<int> ForceBuffersY;
RWStructuredBuffer<float2> Velocities;

RWBuffer<float> Densities;
RWBuffer<float> Lambdas;
RWStructuredBuffer<float2> DeltaPositions;


RWBuffer<uint> Grid;
RWBuffer<uint> Neighbours;
RWBuffer<uint> CellsLength;
RWBuffer<uint> NeighboursLength;

RWStructuredBuffer<float2> BoundaryPositions;
RWStructuredBuffer<float2> BoundaryPrevPositions;
RWStructuredBuffer<float2> BoundaryRestPositions;
RWStructuredBuffer<float2> BoundaryVelocities;
RWBuffer<float> BoundaryVolumes;
RWBuffer<int> BoundaryForceBuffersX;
RWBuffer<int> BoundaryForceBuffersY;

RWBuffer<uint> BoundaryGrid;
RWBuffer<uint> BoundaryCellsLength;
RWBuffer<uint> BoundaryNeighbours;
RWBuffer<uint> BoundaryNeighboursLength;

// Read-only views of the RW buffers above
StructuredBuffer<float2> PositionsRO;
StructuredBuffer<float2> VelocitiesRO;
Buffer<float> LambdasRO;
Buffer<uint> NeighboursRO;
Buffer<uint> NeighboursLengthRO;
StructuredBuffer<float2> BoundaryPositionsRO;
StructuredBuffer<float2> BoundaryVelocitiesRO;
Buffer<float> BoundaryVolumesRO;
Buffer<uint> BoundaryNeighboursRO;
Buffer<uint> BoundaryNeighboursLengthRO;

// [0..1] body centre, [2] angle, [3..4] wall contact on x and y this frame
RWStructuredBuffer<float> BodyState;

RWBuffer<float> DebugFloat;
RWBuffer<int> DebugInt;

const uint numParticles;
const float particleRadius;
const float interactionRadius;
const float interactionRadiusSq;

const float gravity;
const float mouseAttractiveness;
const float mouseRadius;

const float particleVolume;
const float particleMass;
const float relaxation;
const float artificialPressure;
const float poly6Factor;
const float spikyGradFactor;

const float highViscosity;
const float lowViscosity;

const float collisionDamp;
const float2 realHalfBoundSize;

const float2 mousePosition;
const float dt;

const uint numCells;
const uint maxParticlesPerCell;
const float2 offset;
const float cellLength;
const uint columns;
const uint rows;

const uint numBoundaryParticles;
const float boundaryFriction;
const float invBodyMass;
const float2 boundaryRestCenter;
const float bodyRadius;

void SetForceBuffer(uint index, float2 value)
{
    ForceBuffersX[index] = (int)(value.x * FloatScale);
    ForceBuffersY[index] = (int)(value.y * FloatScale);
}

void AtomicAddForceBuffer(uint index, float2 value)
{
    InterlockedAdd(ForceBuffersX[index], (int)(value.x * FloatScale));
    InterlockedAdd(ForceBuffersY[index], (int)(value.y * FloatScale));
}

float2 ReadForceBuffer(uint index)
{
    return float2((float)ForceBuffersX[index] / FloatScale,
    (float)ForceBuffersY[index] / FloatScale);
}

void SetBoundaryForceBuffer(uint index, float2 value)
{
    BoundaryForceBuffersX[index] = (int)(value.x * FloatScale);
    BoundaryForceBuffersY[index] = (int)(value.y * FloatScale);
}

void AtomicAddBoundaryForceBuffer(uint index, float2 value)
{
    InterlockedAdd(BoundaryForceBuffersX[index], (int)(value.x * FloatScale));
    InterlockedAdd(BoundaryForceBuffersY[index], (int)(value.y * FloatScale));
}

float2 ReadBoundaryForceBuffer(uint index)
{
    return float2((float)BoundaryForceBuffersX[index] / FloatScale,
    (float)BoundaryForceBuffersY[index] / FloatScale);
}

[numthreads(64,1,1)]
void ExternalForces (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    Velocities[id.x].y += dt * gravity;
}

[numthreads(64,1,1)]
void ClearForceBuffers (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    SetForceBuffer(id.x, ZeroImpulse);
}

float2 WallDistances(float2 position)
{
    return saturate((realHalfBoundSize - abs(position)) / interactionRadius);
}

[numthreads(64,1,1)]
void CalculateLambdas (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    float2 position = PositionsRO[id.x];
    float density = 0;
    float2 gradient = 0;
    float neighbourGradients = 0;

    for (uint i = 0; i < NeighboursLengthRO[id.x]; i++)
    {
        float2 neighbourPosition = PositionsRO[NeighboursRO[id.x + i * numParticles]];
        float magSq = DistanceSq(position, neighbourPosition);
        if (magSq >= interactionRadiusSq) continue;

        density += particleVolume * Poly6(magSq, interactionRadiusSq, poly6Factor);
        if (magSq == 0) continue;

        float mag = sqrt(magSq);
        float2 neighbourGradient = particleVolume *
            SpikyGradient(mag, interactionRadius, spikyGradFactor, UnitVector(position, neighbourPosition, mag));

        gradient += neighbourGradient;
        neighbourGradients += dot(neighbourGradient, neighbourGradient);
    }

    for (uint b = 0; b < BoundaryNeighboursLengthRO[id.x]; b++)
    {
        uint bIndex = BoundaryNeighboursRO[id.x + b * numParticles];
        float2 boundaryPosition = BoundaryPositionsRO[bIndex];
        float magSq = DistanceSq(position, boundaryPosition);
        float mag = sqrt(magSq);

        // Branchless mask: 0 when the particles coincide or are out of range
        float w = step(1e-12, magSq) * step(magSq, interactionRadiusSq);
        float volume = BoundaryVolumesRO[bIndex];
        float2 r = (boundaryPosition - position) / max(mag, 1e-9);

        density += w * volume * Poly6(magSq, interactionRadiusSq, poly6Factor);
        gradient += w * volume * SpikyGradient(mag, interactionRadius, spikyGradFactor, r);
    }

    // The walls count as fluid at rest beyond them
    float2 wallDistances = WallDistances(position);
    density += dot(WallDensity(wallDistances), float2(1, 1));
    gradient += sign(position) * WallDensityGradient(wallDistances, interactionRadius);

    // Clamped so the free surface never pulls
    float constraint = max(density - 1.0, 0.0);
    Densities[id.x] = density;
    Lambdas[id.x] = -constraint / (dot(gradient, gradient) + neighbourGradients + relaxation);
}

[numthreads(64,1,1)]
void CalculateDeltaPositions (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    float2 position = PositionsRO[id.x];
    float lambda = LambdasRO[id.x];

    // Artificial pressure (s_corr) keeps particles from clumping
    float sCorrKernel = Poly6(0.04 * interactionRadiusSq, interactionRadiusSq, poly6Factor);
    float2 delta = 0;

    for (uint i = 0; i < NeighboursLengthRO[id.x]; i++)
    {
        uint neighbour = NeighboursRO[id.x + i * numParticles];
        float2 neighbourPosition = PositionsRO[neighbour];
        float magSq = DistanceSq(position, neighbourPosition);
        if (magSq == 0 || magSq >= interactionRadiusSq) continue;

        float mag = sqrt(magSq);
        float ratio = Poly6(magSq, interactionRadiusSq, poly6Factor) / sCorrKernel;
        float sCorr = -artificialPressure * ratio * ratio * ratio * ratio;

        delta += particleVolume * (lambda + LambdasRO[neighbour] + sCorr) *
            SpikyGradient(mag, interactionRadius, spikyGradFactor, UnitVector(position, neighbourPosition, mag));
    }

    for (uint b = 0; b < BoundaryNeighboursLengthRO[id.x]; b++)
    {
        uint bIndex = BoundaryNeighboursRO[id.x + b * numParticles];
        float2 boundaryPosition = BoundaryPositionsRO[bIndex];
        float magSq = DistanceSq(position, boundaryPosition);
        float mag = sqrt(magSq);

        float w = step(1e-12, magSq) * step(magSq, interactionRadiusSq);
        float2 r = (boundaryPosition - position) / max(mag, 1e-9);
        float2 correction = w * lambda * BoundaryVolumesRO[bIndex] *
            SpikyGradient(mag, interactionRadius, spikyGradFactor, r);

        delta += correction;
        // Weighted by particleMass so momentum is kept
        AtomicAddBoundaryForceBuffer(bIndex, -particleMass * correction);
    }

    delta += lambda * sign(position) * WallDensityGradient(WallDistances(position), interactionRadius);

    DeltaPositions[id.x] = delta;
}

[numthreads(64,1,1)]
void ApplyDeltaPositions (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    Positions[id.x] += DeltaPositions[id.x];
}

[numthreads(64,1,1)]
void ApplyForceBuffersToVelocities (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    Velocities[id.x] += ReadForceBuffer(id.x);
}

[numthreads(64,1,1)]
void ApplyViscosity (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    for (uint i = 0; i < NeighboursLengthRO[id.x]; i++)
    {
        float mag = Distance(PositionsRO[id.x], PositionsRO[NeighboursRO[id.x + i * numParticles]]);
        if (mag > interactionRadius || mag == 0) continue;

        float q = mag / interactionRadius;
        float2 r = UnitVector(PositionsRO[id.x], PositionsRO[NeighboursRO[id.x + i * numParticles]], mag);
        float inwardVelocity = dot(VelocitiesRO[id.x] - VelocitiesRO[NeighboursRO[id.x + i * numParticles]], r);
        if(inwardVelocity <= 0) continue;

        float2 impulse = ViscosityImpulse(dt, highViscosity, lowViscosity, q, inwardVelocity, r) * 0.5f;
        AtomicAddForceBuffer(id.x, -impulse);
        AtomicAddForceBuffer(NeighboursRO[id.x + i * numParticles], impulse);
    }

    for (uint b = 0; b < BoundaryNeighboursLengthRO[id.x]; b++)
    {
        uint bIndex = BoundaryNeighboursRO[id.x + b * numParticles];
        float magSq = DistanceSq(PositionsRO[id.x], BoundaryPositionsRO[bIndex]);
        float mag = sqrt(magSq);
        float q = mag / interactionRadius;

        float2 r = (BoundaryPositionsRO[bIndex] - PositionsRO[id.x]) / max(mag, 1e-9);
        float inwardVelocity = dot(VelocitiesRO[id.x] - BoundaryVelocitiesRO[bIndex], r);

        float w = step(1e-12, magSq) * step(q, 1.0) * step(0.0, inwardVelocity);
        float2 impulse = ViscosityImpulse(dt, boundaryFriction, 0.0, q, inwardVelocity, r);

        AtomicAddForceBuffer(id.x, -w * impulse);
    }
}

[numthreads(64,1,1)]
void ResolveBoundaries (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    if (abs(Positions[id.x].x) >= realHalfBoundSize.x)
    {
        int signOfPos = sign(Positions[id.x].x);
        Positions[id.x].x = realHalfBoundSize.x * signOfPos;
        Positions[id.x].x -= signOfPos * collisionDamp;
    }

    if (abs(Positions[id.x].y) >= realHalfBoundSize.y)
    {
        int signOfPos = sign(Positions[id.x].y);
        Positions[id.x].y = realHalfBoundSize.y * signOfPos;
        Positions[id.x].y -= signOfPos * collisionDamp;
    }
}

[numthreads(64,1,1)]
void AdvancePredictedPositions (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    PrevPositions[id.x] = Positions[id.x];
    Positions[id.x] += dt * Velocities[id.x];
}

[numthreads(64,1,1)]
void AttractToMouse (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    float mag = Distance(Positions[id.x], mousePosition);
    if (mag > mouseRadius) return;

    float2 r = UnitVector(Positions[id.x], mousePosition, mag);
    Positions[id.x] += dt * mouseAttractiveness * r;
}

[numthreads(64,1,1)]
void AttractToMouseBoundary (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numBoundaryParticles) return;

    float mag = Distance(BoundaryPositions[id.x], mousePosition);
    if (mag > mouseRadius) return;

    float2 r = UnitVector(BoundaryPositions[id.x], mousePosition, mag);
    BoundaryPositions[id.x] += dt * mouseAttractiveness * r;
}

[numthreads(64,1,1)]
void CalculateVelocity (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    Velocities[id.x] = (Positions[id.x] - PrevPositions[id.x]) / dt;
}

static int2 offsets2D[9] =
{
    int2(-1, 1),
    int2(0, 1),
    int2(1, 1),
    int2(-1, 0),
    int2(0, 0),
    int2(1, 0),
    int2(-1, -1),
    int2(0, -1),
    int2(1, -1),
};

uint2 GetCellPosition(float2 position)
{
    float2 scaled = (position - offset) / cellLength;
    return uint2((uint)clamp(scaled.x, 0, columns - 1),
    (uint)clamp(scaled.y, 0, rows - 1));
}

uint GetCellIndex(float2 position)
{
    uint2 cellPosition = GetCellPosition(position);
    return cellPosition.x + cellPosition.y * columns;
}

[numthreads(64,1,1)]
void ClearGrid (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numCells) return;

    CellsLength[id.x] = 0;
}

[numthreads(64,1,1)]
void ClearNeighbours (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    NeighboursLength[id.x] = 0;
}

[numthreads(64,1,1)]
void InitSpatialPartitoning (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    uint2 cellPosition = GetCellPosition(Positions[id.x]);
    uint cellIndex = cellPosition.x + cellPosition.y * columns;
    uint ret;
    // Grid is column-major per slot: slot k of every cell lives at cellIndex + k * numCells
    InterlockedAdd(CellsLength[cellIndex], 1, ret);

    if (ret < maxParticlesPerCell)
    {
        uint gridIndex = cellPosition.x + cellPosition.y * columns + ret * columns * rows;
        Grid[cellPosition.x + cellPosition.y * columns + ret * columns * rows] = id.x;
    }
}

[numthreads(64,1,1)]
void SetNeighbours (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    uint2 cellPosition = GetCellPosition(Positions[id.x]);

    for (uint i = 0; i < 9; i++)
    {
        uint2 neighbourPos = cellPosition + offsets2D[i];
        if (neighbourPos.x == 0xFFFFFFFF || neighbourPos.y == 0xFFFFFFFF || neighbourPos.x >= columns || neighbourPos.y >= rows) continue;
        uint neighbourIndex = neighbourPos.x + neighbourPos.y * columns;

        for (uint j = 0; j < CellsLength[neighbourIndex]; j++)
        {
            if (j >= maxParticlesPerCell)
            continue;

            uint index;
            InterlockedAdd(NeighboursLength[id.x], 1, index);

            uint gridIndex = neighbourPos.x + neighbourPos.y * columns + j * columns * rows;
            // Neighbour k of particle i is stored at i + k * numParticles
            Neighbours[id.x + index * numParticles] = Grid[gridIndex];
        }
    }
}

float2 WallPushOut(float2 pos)
{
    float2 outside = step(realHalfBoundSize, abs(pos));
    return (sign(pos) * realHalfBoundSize - pos) * outside;
}

[numthreads(64,1,1)]
void BoundaryExternalForces (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numBoundaryParticles) return;

    BoundaryVelocities[id.x].y += dt * gravity;
}

[numthreads(64,1,1)]
void ClearBoundaryForceBuffers (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numBoundaryParticles) return;

    SetBoundaryForceBuffer(id.x, ZeroImpulse);
}

[numthreads(64,1,1)]
void ApplyBoundaryForceBuffers (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numBoundaryParticles) return;

    BoundaryPositions[id.x] += invBodyMass * ReadBoundaryForceBuffer(id.x);
}

[numthreads(64,1,1)]
void BoundaryAdvancePredictedPositions (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numBoundaryParticles) return;

    BoundaryPrevPositions[id.x] = BoundaryPositions[id.x];
    BoundaryPositions[id.x] += dt * BoundaryVelocities[id.x];
}

[numthreads(64,1,1)]
void BoundaryCalculateVelocity (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numBoundaryParticles) return;

    BoundaryVelocities[id.x] = (BoundaryPositions[id.x] - BoundaryPrevPositions[id.x]) / dt;
}

[numthreads(64,1,1)]
void ClearBoundaryGrid (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numCells) return;

    BoundaryCellsLength[id.x] = 0;
}

[numthreads(64,1,1)]
void InitBoundarySpatialPartitoning (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numBoundaryParticles) return;

    uint2 cellPosition = GetCellPosition(BoundaryPositions[id.x]);
    uint cellIndex = cellPosition.x + cellPosition.y * columns;
    uint ret;
    InterlockedAdd(BoundaryCellsLength[cellIndex], 1, ret);

    uint slot = min(ret, maxParticlesPerCell - 1);
    BoundaryGrid[cellIndex + slot * columns * rows] = id.x;
}

[numthreads(64,1,1)]
void SetBoundaryNeighbours (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    uint2 cellPosition = GetCellPosition(Positions[id.x]);
    uint count = 0;

    for (uint i = 0; i < 9; i++)
    {
        uint2 neighbourPos = cellPosition + offsets2D[i];

        uint valid = (uint)(neighbourPos.x < columns) * (uint)(neighbourPos.y < rows);
        uint neighbourIndex = min(neighbourPos.x, columns - 1) + min(neighbourPos.y, rows - 1) * columns;
        uint cellCount = min(BoundaryCellsLength[neighbourIndex], maxParticlesPerCell) * valid;

        for (uint j = 0; j < cellCount; j++)
        {
            uint gridIndex = neighbourIndex + j * columns * rows;
            BoundaryNeighbours[id.x + count * numParticles] = BoundaryGrid[gridIndex];
            count++;
        }
    }

    BoundaryNeighboursLength[id.x] = count;
}

[numthreads(64,1,1)]
void CalculateBoundaryVolumes (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numBoundaryParticles) return;

    uint2 cellPosition = GetCellPosition(BoundaryPositions[id.x]);
    float delta = 0;

    for (uint i = 0; i < 9; i++)
    {
        uint2 neighbourPos = cellPosition + offsets2D[i];
        uint valid = (uint)(neighbourPos.x < columns) * (uint)(neighbourPos.y < rows);
        uint neighbourIndex = min(neighbourPos.x, columns - 1) + min(neighbourPos.y, rows - 1) * columns;
        uint cellCount = min(BoundaryCellsLength[neighbourIndex], maxParticlesPerCell) * valid;

        for (uint j = 0; j < cellCount; j++)
        {
            uint n = BoundaryGrid[neighbourIndex + j * columns * rows];
            float magSq = DistanceSq(BoundaryPositions[id.x], BoundaryPositions[n]);

            delta += Poly6(magSq, interactionRadiusSq, poly6Factor);
        }
    }

    BoundaryVolumes[id.x] = delta > 0 ? 1.0 / delta : 0.0;
}

// Body kernels run as a single group: strided loops plus a shared-memory tree reduction
#define ReductionThreads 256
groupshared float2 gsFloat2A[ReductionThreads];
groupshared float2 gsFloat2B[ReductionThreads];
groupshared float gsFloatA[ReductionThreads];

[numthreads(ReductionThreads,1,1)]
// Body centre and best-fit rotation relative to the rest shape, written to BodyState
void FindRotationAngle (uint3 id : SV_GroupThreadID)
{
    float2 sum = float2(0, 0);
    for (uint i = id.x; i < numBoundaryParticles; i += ReductionThreads)
        sum += BoundaryPositions[i];

    gsFloat2A[id.x] = sum;
    GroupMemoryBarrierWithGroupSync();

    for (uint s = ReductionThreads / 2; s > 0; s >>= 1)
    {
        if (id.x < s) gsFloat2A[id.x] += gsFloat2A[id.x + s];
        GroupMemoryBarrierWithGroupSync();
    }

    float2 center = gsFloat2A[0] / numBoundaryParticles;

    float2 cosSin = float2(0, 0);
    for (uint j = id.x; j < numBoundaryParticles; j += ReductionThreads)
    {
        float2 centerDisp = BoundaryPositions[j] - center;
        float2 restDisp = BoundaryRestPositions[j] - boundaryRestCenter;
        cosSin.x += dot(centerDisp, restDisp);
        cosSin.y += centerDisp.y * restDisp.x - centerDisp.x * restDisp.y;
    }

    GroupMemoryBarrierWithGroupSync();
    gsFloat2B[id.x] = cosSin;
    GroupMemoryBarrierWithGroupSync();

    for (uint t = ReductionThreads / 2; t > 0; t >>= 1)
    {
        if (id.x < t) gsFloat2B[id.x] += gsFloat2B[id.x + t];
        GroupMemoryBarrierWithGroupSync();
    }

    if (id.x == 0)
    {
        BodyState[0] = center.x;
        BodyState[1] = center.y;
        BodyState[2] = atan2(gsFloat2B[0].y, gsFloat2B[0].x);
    }
}

[numthreads(64,1,1)]
void PlaceBoundaryParticles (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numBoundaryParticles) return;

    float2 center = float2(BodyState[0], BodyState[1]);
    float angle = BodyState[2];
    float cosA = cos(angle);
    float sinA = sin(angle);

    float2 restDisp = BoundaryRestPositions[id.x] - boundaryRestCenter;
    BoundaryPositions[id.x] = center + float2(cosA * restDisp.x - sinA * restDisp.y,
                                              sinA * restDisp.x + cosA * restDisp.y);
}

[numthreads(ReductionThreads,1,1)]
// Pushes the body out of the walls and levels it about the contact centroid.
// With no contact every term is masked to 0, so the update is the identity
void RigidContactResolution (uint3 id : SV_GroupThreadID)
{
    float2 sumDelta = float2(0, 0);
    float2 sumContactPos = float2(0, 0);
    float contacts = 0;

    for (uint i = id.x; i < numBoundaryParticles; i += ReductionThreads)
    {
        float2 delta = WallPushOut(BoundaryPositions[i]);
        float isContact = step(1e-12, dot(delta, delta));

        sumDelta += delta;
        sumContactPos += BoundaryPositions[i] * isContact;
        contacts += isContact;
    }

    gsFloat2A[id.x] = sumDelta;
    gsFloat2B[id.x] = sumContactPos;
    gsFloatA[id.x] = contacts;
    GroupMemoryBarrierWithGroupSync();

    for (uint s = ReductionThreads / 2; s > 0; s >>= 1)
    {
        if (id.x < s)
        {
            gsFloat2A[id.x] += gsFloat2A[id.x + s];
            gsFloat2B[id.x] += gsFloat2B[id.x + s];
            gsFloatA[id.x] += gsFloatA[id.x + s];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    float2 totalDelta = gsFloat2A[0];
    float totalContacts = gsFloatA[0];
    float2 pivot = gsFloat2B[0] / max(totalContacts, 1.0);
    GroupMemoryBarrierWithGroupSync();

    float levelTorque = 0;
    float levelDenom = 0;
    float inertiaPivot = 0;

    for (uint j = id.x; j < numBoundaryParticles; j += ReductionThreads)
    {
        float2 r = BoundaryPositions[j] - pivot;
        inertiaPivot += dot(r, r);

        float2 delta = WallPushOut(BoundaryPositions[j]);
        float isContact = step(1e-12, dot(delta, delta));

        levelTorque += r.x * delta.y - r.y * delta.x;
        levelDenom += dot(r, r) * isContact;
    }

    gsFloat2A[id.x] = float2(levelTorque, levelDenom);
    gsFloatA[id.x] = inertiaPivot;
    GroupMemoryBarrierWithGroupSync();

    for (uint t = ReductionThreads / 2; t > 0; t >>= 1)
    {
        if (id.x < t)
        {
            gsFloat2A[id.x] += gsFloat2A[id.x + t];
            gsFloatA[id.x] += gsFloatA[id.x + t];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if (id.x == 0)
    {
        float hasContact = step(0.5, totalContacts);
        float2 translation = totalDelta / max(totalContacts, 1.0);
        float levelAngle = gsFloat2A[0].x / max(gsFloat2A[0].y, 1e-6);

        float2 center = float2(BodyState[0], BodyState[1]);

        float2 arm = center - pivot;
        float gravityTorque = arm.x * (numBoundaryParticles * gravity);
        // Gravity torque about the pivot, applied as a position-level angle increment
        float gravityAngle = gravityTorque / max(gsFloatA[0], 1e-6) * dt * dt;

        float deltaAngle = (levelAngle + gravityAngle) * hasContact;

        float cosA = cos(deltaAngle);
        float sinA = sin(deltaAngle);
        float2 c = center - pivot;
        center = pivot + float2(cosA * c.x - sinA * c.y, sinA * c.x + cosA * c.y) + translation * hasContact;

        BodyState[0] = center.x;
        BodyState[1] = center.y;
        BodyState[2] += deltaAngle;

        BodyState[3] = step(1e-12, abs(totalDelta.x));
        BodyState[4] = step(1e-12, abs(totalDelta.y));
    }
}

[numthreads(64,1,1)]
void ResolveCircleBodyCollision (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    float2 center = float2(BodyState[0], BodyState[1]);
    float collisionRadius = bodyRadius + particleRadius;

    float2 disp = Positions[id.x] - center;
    float dist = length(disp);
    float prevDist = Distance(center, PrevPositions[id.x]);

    // Resolve unless both the current and previous positions are outside
    float inside = 1.0 - step(collisionRadius, dist) * step(collisionRadius, prevDist);

    float usePrev = step(dist, 1e-9);
    float2 refDisp = lerp(disp, PrevPositions[id.x] - center, usePrev);
    float2 outward = refDisp / max(length(refDisp), 1e-9);

    float2 resolved = center + outward * (collisionRadius + collisionDamp);
    Positions[id.x] = lerp(Positions[id.x], resolved, inside);
}

[numthreads(64,1,1)]
void ResolveSquareBodyCollision (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    float2 center = float2(BodyState[0], BodyState[1]);
    float angle = BodyState[2];
    float cosA = cos(angle);
    float sinA = sin(angle);
    float halfSize = bodyRadius + particleRadius;

    float2 rel = Positions[id.x] - center;
    // Test in the body's local frame, then push out along the axis of least penetration
    float2 local = float2(cosA * rel.x + sinA * rel.y, -sinA * rel.x + cosA * rel.y);

    float2 penetration = halfSize - abs(local);
    float inside = step(0, penetration.x) * step(0, penetration.y);

    float pushX = step(penetration.x, penetration.y);
    float2 pushed = float2(
        lerp(local.x, sign(local.x) * (halfSize + collisionDamp), pushX),
        lerp(local.y, sign(local.y) * (halfSize + collisionDamp), 1.0 - pushX));

    float2 deltaLocal = (pushed - local) * inside;
    Positions[id.x] += float2(cosA * deltaLocal.x - sinA * deltaLocal.y,
                              sinA * deltaLocal.x + cosA * deltaLocal.y);
}

[numthreads(ReductionThreads,1,1)]
// Removes only the mean (translational) velocity into a contacted wall,
// so a body balancing on a corner keeps its tipping motion
void CancelBoundaryBorderVelocity (uint3 id : SV_GroupThreadID)
{
    float2 sum = float2(0, 0);
    for (uint i = id.x; i < numBoundaryParticles; i += ReductionThreads)
        sum += BoundaryPositions[i] - BoundaryPrevPositions[i];

    gsFloat2A[id.x] = sum;
    GroupMemoryBarrierWithGroupSync();

    for (uint s = ReductionThreads / 2; s > 0; s >>= 1)
    {
        if (id.x < s) gsFloat2A[id.x] += gsFloat2A[id.x + s];
        GroupMemoryBarrierWithGroupSync();
    }

    float2 meanDisp = gsFloat2A[0] / numBoundaryParticles;
    float2 contactMask = float2(BodyState[3], BodyState[4]);

    for (uint j = id.x; j < numBoundaryParticles; j += ReductionThreads)
        BoundaryPrevPositions[j] += meanDisp * contactMask;
}